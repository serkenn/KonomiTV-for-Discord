# Discord Developer Portal > 作ったアプリ > OAuth2 にある値
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 視聴を許可する相手。どちらも空だと全員拒否になる。カンマ区切りで複数指定できる。
# サーバー (ギルド) ID: そのサーバーに入っている人は全員見られる
ALLOWED_GUILD_IDS=
# ユーザー ID: 個別に許可する人
ALLOWED_USER_IDS=

# 以下は通常そのままでよい
HOST=127.0.0.1
PORT=7100
KONOMITV_URL=https://127-0-0-1.local.konomi.tv:7000
